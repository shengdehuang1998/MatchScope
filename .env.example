NODE_ENV=development
HOST=0.0.0.0
PORT=8187

POSTGRES_DB=match_insight
POSTGRES_USER=match_insight
POSTGRES_PASSWORD=match_insight_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://match_insight:match_insight_dev@localhost:5432/match_insight

APP_TIMEZONE=Asia/Shanghai
JWT_ACCESS_SECRET=replace_with_a_long_random_value
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGINS=http://localhost:5174,http://localhost:8183

# 初始化命令使用。密码至少 12 位，真实值只放在本地 .env 中。
INIT_USER_EMAIL=owner@example.com
INIT_USER_PASSWORD=replace_with_a_strong_local_password
INIT_USER_DISPLAY_NAME=Owner
INIT_PROMPT_NAME=默认赛前分析模板
INIT_PROMPT_CONTENT=请根据提供的比赛资料进行客观分析，不要编造未提供的事实。

# 真机调试时，将地址替换为当前电脑的局域网 IP。
EXPO_PUBLIC_API_URL=http://192.168.10.127:8187/api/v1
